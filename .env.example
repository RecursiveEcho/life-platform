# life-platform 环境变量示例
#
# 复制为 .env 后按本地环境填写；.env 已被 .gitignore 忽略，不会提交到仓库。
#    cp .env.example .env
#    set -a && source .env && set +a
#    ./mvnw spring-boot:run
#
# 含特殊字符（如 &）的值用引号包起来，避免 source 时被 shell 解析。

# --- 数据库 ---
DB_URL="jdbc:mysql://localhost:3306/life_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai"
DB_USERNAME=root
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# 仅当 Redis 配置了 requirepass 时需要，未配置密码时留空。
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT ---
# 必填：未设置时应用启动会直接失败。
# 生成一个随机密钥：openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*
